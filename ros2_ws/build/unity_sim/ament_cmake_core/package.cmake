set(_AMENT_PACKAGE_NAME "unity_sim")
set(unity_sim_VERSION "0.0.1")
set(unity_sim_MAINTAINER "Unity Robotics <unity-robotics@unity.com>")
set(unity_sim_BUILD_DEPENDS "rosidl_default_generators")
set(unity_sim_BUILDTOOL_DEPENDS "ament_cmake")
set(unity_sim_BUILD_EXPORT_DEPENDS )
set(unity_sim_BUILDTOOL_EXPORT_DEPENDS )
set(unity_sim_EXEC_DEPENDS "rosidl_default_runtime")
set(unity_sim_TEST_DEPENDS "ament_lint_auto" "ament_lint_common")
set(unity_sim_GROUP_DEPENDS )
set(unity_sim_MEMBER_OF_GROUPS "rosidl_interface_packages")
set(unity_sim_DEPRECATED "")
set(unity_sim_EXPORT_TAGS)
list(APPEND unity_sim_EXPORT_TAGS "<build_type>ament_cmake</build_type>")
list(APPEND unity_sim_EXPORT_TAGS "<ros1_bridge mapping_rules=\"ros1_mapping_rules.yaml\"/>")
